{
  "$defs": {
    "ForecastCandidate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "naive",
            "seasonal_naive",
            "mean",
            "median",
            "ses",
            "local_trend",
            "damped_local_trend",
            "anomalyzer"
          ],
          "title": "Method",
          "type": "string"
        },
        "training_window": {
          "anyOf": [
            {
              "maximum": 6000,
              "minimum": 8,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Window"
        },
        "period": {
          "anyOf": [
            {
              "maximum": 1500,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "alpha": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alpha"
        },
        "damping": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Damping"
        },
        "outlier_handling": {
          "default": "include",
          "enum": [
            "include",
            "robust"
          ],
          "title": "Outlier Handling",
          "type": "string"
        },
        "trend": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "none",
                "linear",
                "exponential"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trend"
        },
        "baseline": {
          "anyOf": [
            {
              "enum": [
                "legacy",
                "recent-level-v1"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        }
      },
      "required": [
        "id",
        "method"
      ],
      "title": "ForecastCandidate",
      "type": "object"
    },
    "ForecastDataset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "default": "series",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 6000,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "period_statuses": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "complete",
                  "partial",
                  "missing"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period Statuses"
        },
        "interval": {
          "default": "day",
          "enum": [
            "hour",
            "day",
            "week",
            "month",
            "year"
          ],
          "title": "Interval",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "title": "Timezone",
          "type": "string"
        },
        "timestamps": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamps"
        }
      },
      "required": [
        "values"
      ],
      "title": "ForecastDataset",
      "type": "object"
    },
    "ForecastSelectionSettings": {
      "additionalProperties": false,
      "properties": {
        "horizon": {
          "default": 14,
          "maximum": 6000,
          "minimum": 1,
          "title": "Horizon",
          "type": "integer"
        },
        "lower_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Bound"
        },
        "trend_adjustment_pct": {
          "default": 0,
          "maximum": 200,
          "minimum": -50,
          "title": "Trend Adjustment Pct",
          "type": "number"
        },
        "max_points": {
          "default": 6000,
          "maximum": 6000,
          "minimum": 1,
          "title": "Max Points",
          "type": "integer"
        },
        "max_runtime_seconds": {
          "default": 10,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Max Runtime Seconds",
          "type": "number"
        },
        "objective": {
          "default": "mae",
          "enum": [
            "mae",
            "rmse",
            "total_absolute_error"
          ],
          "title": "Objective",
          "type": "string"
        },
        "folds": {
          "default": 3,
          "maximum": 8,
          "minimum": 3,
          "title": "Folds",
          "type": "integer"
        },
        "min_training_points": {
          "default": 28,
          "maximum": 6000,
          "minimum": 8,
          "title": "Min Training Points",
          "type": "integer"
        }
      },
      "title": "ForecastSelectionSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "forecast-selection-v1",
      "default": "forecast-selection-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "task": {
      "const": "select_forecast",
      "default": "select_forecast",
      "title": "Task",
      "type": "string"
    },
    "dataset": {
      "$ref": "#/$defs/ForecastDataset"
    },
    "config": {
      "$ref": "#/$defs/ForecastSelectionSettings"
    },
    "candidates": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ForecastCandidate"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidates"
    }
  },
  "required": [
    "dataset"
  ],
  "title": "ForecastSelectionRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
