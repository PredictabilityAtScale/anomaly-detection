      "type": "string"
    },
    "input_fingerprint": {
      "title": "Input Fingerprint",
      "type": "string"
    },
    "reference_id": {
      "title": "Reference Id",
      "type": "string"
    },
    "evaluations": {
      "items": {
        "additionalProperties": true,
