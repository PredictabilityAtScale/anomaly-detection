    },
    "testing": {
      "additionalProperties": true,
      "title": "Testing",
      "type": "object"
    },
    "data_quality": {
      "additionalProperties": true,
      "title": "Data Quality",
      "type": "object"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
